# Supabase 프로젝트 설정(Project Settings > API)에서 값을 채워주세요.

# 브라우저에도 노출되는 공개 키 (anon key) — RLS로 보호되므로 노출되어도 안전합니다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 서버 전용 비밀 키. RLS를 우회하므로 절대 클라이언트/커밋에 노출하지 마세요.
# 계정 발급(Auth Admin API), audit log 등 서버 전용 작업에만 사용합니다.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
